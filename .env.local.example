# Supabase
# Found in your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key - server-side only, NEVER expose to the client.
# Used only inside app/api/** route handlers.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend - manufacturer application/approval/rejection emails
RESEND_API_KEY=your-resend-api-key

# Anthropic - Module 3's machine format AI analysis
ANTHROPIC_API_KEY=your-anthropic-api-key

# Email address that receives new-manufacturer-application notifications.
# Optional - if unset, that notification is skipped.
ADMIN_EMAIL=admin@example.com

# Phase 4 Module 4 - shared pilot RSA private key (PEM) used to sign every
# manufacturer's QR payloads during the pilot (see
# lib/manufacturers/crypto-signer.ts). Generate one locally with:
#   node -e "console.log(require('crypto').generateKeyPairSync('rsa',{modulusLength:2048,privateKeyEncoding:{type:'pkcs8',format:'pem'},publicKeyEncoding:{type:'spki',format:'pem'}}).privateKey)"
# Paste the full PEM (including the BEGIN/END lines) as the value - either
# as real newlines or with them escaped as \n, both are accepted.
VERIGUARD_PILOT_PRIVATE_KEY=your-pilot-rsa-private-key-pem

# Phase 5 Module 1 - Paystack billing. Test-mode keys from
# https://dashboard.paystack.com/#/settings/developers. The checkout flow
# is a full-page redirect to Paystack's own hosted page (authorization_url),
# not their inline popup SDK - no client-side Paystack script or public key
# is needed anywhere in this app.
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# Same value entered as the webhook URL in the Paystack dashboard
# (https://dashboard.paystack.com/#/settings/developers ->
# Webhook URL: https://your-deployed-domain.example/api/webhooks/paystack).
# No separate secret to configure here - Paystack signs webhook deliveries
# with PAYSTACK_SECRET_KEY itself (see verifyWebhookSignature).

# Phase 4 Module 7 - the base URL actually printed inside every generated
# QR code (see buildVerificationUrl in lib/manufacturers/code-generator.ts)
# and used by the WhatsApp bot's reply links. Set this to your real
# deployed URL (e.g. https://veriguard-one.vercel.app) - if unset, it
# silently falls back to https://veriguard.ng, which won't resolve to this
# app unless you actually own and point that domain here. Any batch
# exported before this is set correctly will have unscannable QR codes.
NEXT_PUBLIC_APP_URL=https://your-deployed-domain.example
